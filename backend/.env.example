NODE_ENV=development
PORT=4000

# Runtime connection (on Neon/Vercel use the POOLED string)
DATABASE_URL=postgresql://brian-ecommerce:brian-ecommerce@localhost:5432/brian-ecommerce
# Direct (non-pooled) connection used by `prisma migrate`. Locally the same as DATABASE_URL.
DIRECT_URL=postgresql://brian-ecommerce:brian-ecommerce@localhost:5432/brian-ecommerce

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Stripe TEST mode keys only — never put live keys in this repo
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

FRONTEND_ORIGIN=http://localhost:5173
